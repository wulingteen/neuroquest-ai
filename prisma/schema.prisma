generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model achievements {
  achievement_id String   @id
  name           String
  description    String?
  icon           String?
  rarity         String
  xp_reward      Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model arena_challenges {
  challenge_id    String   @id
  title           String
  description     String?
  difficulty      String
  example_prompts Json     @default("[]")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([difficulty], map: "idx_arena_challenges_difficulty")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model levels {
  level_id        Int               @id
  rollup          String
  level_number    Int
  title           String
  content_type    String
  xp_reward       Int               @default(0)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  planets         planets           @relation(fields: [rollup], references: [rollup], onDelete: Cascade, onUpdate: NoAction)
  player_progress player_progress[]
  quiz_questions  quiz_questions[]

  @@unique([rollup, level_number])
  @@index([rollup], map: "idx_levels_rollup")
}

model planets {
  planet_id       Int       @id
  rollup          String    @unique
  label           String
  subtitle        String?
  icon            String?
  color           String?
  glow_color      String?
  bg_gradient     String?
  x               Int
  y               Int
  description     String?
  required_rollup String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  levels          levels[]
  planets         planets?  @relation("planetsToplanets", fields: [required_rollup], references: [rollup], onUpdate: NoAction)
  other_planets   planets[] @relation("planetsToplanets")
  quiz_questions  quiz_questions[]

  @@index([required_rollup], map: "idx_planets_required_rollup")
}

model player_progress {
  player_id    String   @db.Uuid
  level_id     Int
  completed_at DateTime @default(now()) @db.Timestamptz(6)
  levels       levels   @relation(fields: [level_id], references: [level_id], onDelete: Cascade, onUpdate: NoAction)
  players      players  @relation(fields: [player_id], references: [player_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([player_id, level_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model players {
  player_id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username               String               @unique
  email                  String?              @unique
  avatar                 String?
  xp                     Int                  @default(0)
  streak_days            Int                  @default(0)
  guild_name             String?
  last_login_at          DateTime?            @db.Timestamptz(6)
  last_reward_claimed_at DateTime?            @db.Timestamptz(6)
  level                  Int?                 @default(dbgenerated("(floor(((xp / 1000))::double precision) + (1)::double precision)"))
  created_at             DateTime             @default(now()) @db.Timestamptz(6)
  player_progress        player_progress[]
  player_profile         player_profiles?
  player_news_answers    player_news_answers[]
  friends                friends[]              @relation("player_friends")
  friend_of              friends[]              @relation("friend_players")
  sent_friend_requests   friend_requests[]      @relation("request_sender")
  received_friend_requests friend_requests[]    @relation("request_receiver")
  daily_top_messages     daily_top_messages[]
  player_achievements    player_achievements[]

  @@index([xp(sort: Desc)], map: "idx_players_xp")
}

/// Profile option choices for background and interests with scores
model profile_options {
  option_id   BigInt  @id @default(autoincrement())
  category    String
  option_key  String
  label       String
  icon        String  @default("📌")
  description String?
  score       Int
  sort_order  Int     @default(0)

  @@unique([category, option_key])
  @@index([category], map: "idx_profile_options_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model player_profiles {
  player_id        String   @id @db.Uuid
  background       String
  interests        String[]
  difficulty_score Int      @default(50)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  players          players  @relation(fields: [player_id], references: [player_id], onDelete: Cascade, onUpdate: NoAction)
}

model rss_feeds {
  feed_id         BigInt          @id @default(autoincrement())
  url             String          @unique
  name            String
  enabled         Boolean         @default(true)
  last_fetched_at DateTime?       @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  news_articles        news_articles[]
  cron_scan_feed_logs  cron_scan_feed_logs[]

  @@index([enabled], map: "idx_rss_feeds_enabled")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model llm_configs {
  config_id      BigInt   @id @default(autoincrement())
  role           String   @unique
  provider       String
  model_name     String
  api_key_env_var String
  parameters     Json     @default("{}")
  enabled        Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
}

model news_articles {
  article_id      BigInt            @id @default(autoincrement())
  feed_id         BigInt
  url             String            @unique
  title           String
  summary         String?
  full_text       String?
  published_at    DateTime?         @db.Timestamptz(6)
  fetched_at      DateTime          @default(now()) @db.Timestamptz(6)
  rss_feeds       rss_feeds         @relation(fields: [feed_id], references: [feed_id], onDelete: Cascade, onUpdate: NoAction)
  news_selections news_selections[]

  @@index([feed_id], map: "idx_news_articles_feed_id")
  @@index([fetched_at], map: "idx_news_articles_fetched_at")
}

model news_selections {
  selection_id   BigInt           @id @default(autoincrement())
  article_id     BigInt
  tier           Int
  cycle_date     DateTime         @db.Date
  news_articles  news_articles    @relation(fields: [article_id], references: [article_id], onDelete: Cascade, onUpdate: NoAction)
  news_questions news_questions[]

  @@unique([article_id, tier, cycle_date])
  @@index([tier, cycle_date], map: "idx_news_selections_tier_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model news_questions {
  question_id          BigInt               @id @default(autoincrement())
  selection_id         BigInt
  question_number      Int
  question_text        String
  options              Json
  correct_option_index Int
  explanation          String?
  xp_reward            Int                  @default(50)
  news_selections      news_selections      @relation(fields: [selection_id], references: [selection_id], onDelete: Cascade, onUpdate: NoAction)
  player_news_answers  player_news_answers[]

  @@unique([selection_id, question_number])
  @@index([selection_id], map: "idx_news_questions_selection_id")
}

model player_news_answers {
  player_id             String         @db.Uuid
  question_id           BigInt
  selected_option_index Int
  is_correct            Boolean
  xp_earned             Int            @default(0)
  answered_at           DateTime       @default(now()) @db.Timestamptz(6)
  players               players        @relation(fields: [player_id], references: [player_id], onDelete: Cascade, onUpdate: NoAction)
  news_questions        news_questions @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([player_id, question_id])
  @@index([question_id], map: "idx_player_news_answers_question_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quiz_questions {
  question_id          Int      @id @default(autoincrement())
  rollup               String
  level_number         Int
  question_number      Int
  question_text        String
  options              Json
  correct_option_index Int
  explanation          String?
  xp_reward            Int      @default(0)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
  levels               levels   @relation(fields: [rollup, level_number], references: [rollup, level_number], onDelete: Cascade, onUpdate: NoAction)
  planets              planets  @relation(fields: [rollup], references: [rollup], onDelete: Cascade, onUpdate: NoAction)

  @@unique([rollup, level_number, question_number])
  @@index([rollup, level_number], map: "idx_quiz_questions_level_number")
  @@index([rollup], map: "idx_quiz_questions_rollup")
  @@index([options], map: "idx_quiz_questions_options_gin", type: Gin)
}

/// Cron scan run log — one row per cron invocation
model cron_scan_runs {
  run_id             BigInt                @id @default(autoincrement())
  status             String                @default("running")
  total_feeds        Int                   @default(0)
  feeds_ok           Int                   @default(0)
  feeds_failed       Int                   @default(0)
  articles_found     Int                   @default(0)
  articles_selected  Int                   @default(0)
  error_message      String?
  started_at         DateTime              @default(now()) @db.Timestamptz(6)
  finished_at        DateTime?             @db.Timestamptz(6)
  feed_logs          cron_scan_feed_logs[]

  @@index([started_at(sort: Desc)], map: "idx_cron_scan_runs_started_at")
}

/// Cron scan per-feed log — one row per feed per run
model cron_scan_feed_logs {
  log_id         BigInt          @id @default(autoincrement())
  run_id         BigInt
  feed_id        BigInt
  feed_url       String
  feed_name      String
  status         String
  articles_found Int             @default(0)
  error_message  String?
  duration_ms    Int?
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  cron_scan_runs cron_scan_runs  @relation(fields: [run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction)
  rss_feeds      rss_feeds       @relation(fields: [feed_id], references: [feed_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id], map: "idx_cron_scan_feed_logs_run_id")
  @@index([feed_id], map: "idx_cron_scan_feed_logs_feed_id")
  @@index([status], map: "idx_cron_scan_feed_logs_status")
}

model friends {
  player_id  String   @db.Uuid
  friend_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  player     players  @relation("player_friends", fields: [player_id], references: [player_id], onDelete: Cascade)
  friend     players  @relation("friend_players", fields: [friend_id], references: [player_id], onDelete: Cascade)

  @@id([player_id, friend_id])
  @@index([friend_id], map: "idx_friends_friend_id")
}

model daily_top_messages {
  message_id   BigInt   @id @default(autoincrement())
  player_id    String   @db.Uuid
  message      String   @db.Text
  message_date DateTime @default(now()) @db.Date
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  player       players  @relation(fields: [player_id], references: [player_id], onDelete: Cascade)

  @@unique([player_id, message_date])
  @@index([message_date], map: "idx_top_messages_date")
}

// top_scorer_notifications was removed — daily_top_messages already encodes
// the "notified/prompted today" semantic via UNIQUE(player_id, message_date).

/// Friend request with consent — status: pending | accepted | declined
model friend_requests {
  request_id   BigInt   @id @default(autoincrement())
  requester_id String   @db.Uuid
  requestee_id String   @db.Uuid
  status       String   @default("pending")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  requester    players  @relation("request_sender",   fields: [requester_id], references: [player_id], onDelete: Cascade)
  requestee    players  @relation("request_receiver", fields: [requestee_id], references: [player_id], onDelete: Cascade)

  @@unique([requester_id, requestee_id])
  @@index([requestee_id, status], map: "idx_friend_requests_requestee_status")
  @@index([requester_id],         map: "idx_friend_requests_requester")
}

model player_achievements {
  player_id      String   @db.Uuid
  achievement_id String
  unlocked_at    DateTime @default(now()) @db.Timestamptz(6)
  player         players  @relation(fields: [player_id], references: [player_id], onDelete: Cascade)

  @@id([player_id, achievement_id])
}
